{
  "name": "bozdoz.com",
  "version": "2.0.0",
  "repository": {
    "url": "https://github.com/bozdoz/bozdoz.com/"
  },
  "description": "The portfolio of Benjamin J DeLong",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=development bun --hot ./src/index.tsx",
    "build": "bun run build:server && bun run build:client && bun run build:copy",
    "build:server": "bun build --target=bun --production --outdir=dist ./src/index.tsx",
    "build:client": "bun run --production ./src/build.ts",
    "build:copy": "cp -r ./src/pages ./dist",
    "bundle": "bun build --compile --production --minify ./src/index.tsx --outfile ./dist/app"
  },
  "dependencies": {
    "marked": "^16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "sass": "^1.93.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prettier": "^3.6.2"
  }
}
